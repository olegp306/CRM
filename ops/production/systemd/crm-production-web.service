[Unit]
Description=CRM production web app
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/apps/crm-production/apps/web
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=CRM_REQUIRE_DEPLOYMENT_CONFIRMATION=true
EnvironmentFile=/opt/apps/crm-production/.env
ExecStart=/usr/bin/pnpm exec next start -H 0.0.0.0 -p 3001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
