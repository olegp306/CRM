[Unit]
Description=CRM test web app
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/apps/crm-test/apps/web
Environment=NODE_ENV=production
Environment=PORT=3002
Environment=CRM_REQUIRE_DEPLOYMENT_CONFIRMATION=true
EnvironmentFile=/opt/apps/crm-test/.env
ExecStart=/usr/bin/pnpm exec next start -H 0.0.0.0 -p 3002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
