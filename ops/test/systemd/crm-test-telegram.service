[Unit]
Description=CRM test Telegram worker
After=network-online.target docker.service crm-test-web.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/apps/crm-test/packages/integrations
Environment=NODE_ENV=production
Environment=TELEGRAM_WORKER_MODE=loop
Environment=CRM_REQUIRE_DEPLOYMENT_CONFIRMATION=true
EnvironmentFile=/opt/apps/crm-test/.env
ExecStart=/usr/bin/pnpm worker:telegram:loop
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
